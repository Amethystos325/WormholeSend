<ui:FluentWindow x:Class="WormholeSend.SettingsWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 Title="Wormhole Send 设置"
                 Width="600" Height="720" MinWidth="500" MinHeight="480"
                 WindowStartupLocation="CenterScreen"
                 WindowBackdropType="Mica"
                 ExtendsContentIntoTitleBar="True">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <ui:TitleBar Title="Wormhole Send 设置" ShowMaximize="False" ShowMinimize="False" />

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="24,8,24,24">
                <ui:InfoBar x:Name="Status" Margin="0,0,0,12" IsClosable="True" />

                <ui:CardControl Margin="0,0,0,6">
                    <ui:CardControl.Icon>
                        <ui:SymbolIcon Symbol="Rename24" />
                    </ui:CardControl.Icon>
                    <ui:CardControl.Header>
                        <StackPanel>
                            <ui:TextBlock FontTypography="BodyStrong" Text="设备名称" />
                            <ui:TextBlock Appearance="Secondary" FontTypography="Caption" Text="对方刘海和顶部岛里显示的名字" />
                        </StackPanel>
                    </ui:CardControl.Header>
                    <StackPanel Orientation="Horizontal">
                        <ui:TextBox x:Name="AliasBox" Width="200" MaxLength="64" KeyDown="AliasBox_KeyDown" />
                        <ui:Button Margin="8,0,0,0" Content="保存" Click="SaveAlias_Click" />
                    </StackPanel>
                </ui:CardControl>

                <ui:CardControl Margin="0,0,0,6">
                    <ui:CardControl.Icon>
                        <ui:SymbolIcon Symbol="Folder24" />
                    </ui:CardControl.Icon>
                    <ui:CardControl.Header>
                        <StackPanel>
                            <ui:TextBlock FontTypography="BodyStrong" Text="保存位置" />
                            <ui:TextBlock x:Name="SaveDirText" Appearance="Secondary" FontTypography="Caption" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </ui:CardControl.Header>
                    <StackPanel Orientation="Horizontal">
                        <ui:Button Content="打开" Click="OpenSaveDir_Click" />
                        <ui:Button Margin="8,0,0,0" Content="更改…" Click="ChangeSaveDir_Click" />
                    </StackPanel>
                </ui:CardControl>

                <ui:CardControl Margin="0,0,0,6">
                    <ui:CardControl.Icon>
                        <ui:SymbolIcon Symbol="Star24" />
                    </ui:CardControl.Icon>
                    <ui:CardControl.Header>
                        <StackPanel>
                            <ui:TextBlock FontTypography="BodyStrong" Text="默认设备" />
                            <ui:TextBlock Appearance="Secondary" FontTypography="Caption" Text="拖进顶部岛松手时发给它" />
                        </StackPanel>
                    </ui:CardControl.Header>
                    <ComboBox x:Name="DefaultBox" Width="200" DisplayMemberPath="Name" SelectionChanged="DefaultBox_SelectionChanged" />
                </ui:CardControl>

                <ui:CardControl Margin="0,0,0,6">
                    <ui:CardControl.Icon>
                        <ui:SymbolIcon Symbol="Power24" />
                    </ui:CardControl.Icon>
                    <ui:CardControl.Header>
                        <ui:TextBlock FontTypography="BodyStrong" Text="开机时启动" />
                    </ui:CardControl.Header>
                    <ui:ToggleSwitch x:Name="AutostartSwitch" Checked="Autostart_Changed" Unchecked="Autostart_Changed" />
                </ui:CardControl>

                <DockPanel Margin="0,18,0,8">
                    <ui:Button DockPanel.Dock="Right" Appearance="Primary" Content="配对新设备…" Click="PairNew_Click">
                        <ui:Button.Icon>
                            <ui:SymbolIcon Symbol="Add24" />
                        </ui:Button.Icon>
                    </ui:Button>
                    <ui:TextBlock VerticalAlignment="Center" FontTypography="Subtitle" Text="已配对设备" />
                </DockPanel>
                <StackPanel x:Name="DeviceList" />
                <ui:TextBlock x:Name="NoDevices" Margin="0,4,0,0" Appearance="Secondary"
                              Text="还没有配对设备。在另一台电脑上打开 Wormhole Send，再点“配对新设备”。" TextWrapping="Wrap" />

                <ui:TextBlock x:Name="About" Margin="0,24,0,0" Appearance="Tertiary" FontTypography="Caption" TextWrapping="Wrap" />
            </StackPanel>
        </ScrollViewer>
    </Grid>
</ui:FluentWindow>
