<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <!-- Only for the tray icon (NotifyIcon) and the monitor list (Screen). -->
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AssemblyName>WormholeSend</AssemblyName>
    <Product>Wormhole Send</Product>
    <!-- For the source-generated P/Invoke in Native.cs and Core.cs. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- WinForms would rather set DPI awareness in code, but this is a WPF
         app: the manifest is the place for it. -->
    <NoWarn>$(NoWarn);WFO0003</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <!-- WinForms types clash with WPF ones (Application, Point, Size...);
         the few WinForms uses are written out with a `Forms` alias. -->
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="WormholeSend.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="WPF-UI" Version="4.3.0" />
  </ItemGroup>

  <!-- The Rust core (core-ffi) is built with cargo and copied next to the
       app. SkipCoreBuild=true uses the wormhole.dll already built. -->
  <PropertyGroup>
    <RepoRoot>$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)..\..\..\'))</RepoRoot>
    <CargoExe Condition="Exists('$(USERPROFILE)\.cargo\bin\cargo.exe')">$(USERPROFILE)\.cargo\bin\cargo.exe</CargoExe>
    <CargoExe Condition="'$(CargoExe)' == ''">cargo</CargoExe>
  </PropertyGroup>

  <Target Name="BuildCore" BeforeTargets="BeforeBuild" Condition="'$(SkipCoreBuild)' != 'true'">
    <Exec Command="&quot;$(CargoExe)&quot; build -p wormhole-ffi --release" WorkingDirectory="$(RepoRoot)" />
  </Target>

  <ItemGroup>
    <None Include="$(RepoRoot)target\release\wormhole.dll" Link="wormhole.dll" CopyToOutputDirectory="PreserveNewest" Visible="false" />
  </ItemGroup>

</Project>
