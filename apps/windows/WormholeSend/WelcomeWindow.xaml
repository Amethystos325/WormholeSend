<ui:FluentWindow x:Class="WormholeSend.WelcomeWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:l="clr-namespace:WormholeSend"
                 Title="{x:Static l:S.WelcomeTitle}"
                 Width="520" Height="460" ResizeMode="NoResize"
                 WindowStartupLocation="CenterScreen"
                 WindowBackdropType="Mica"
                 ExtendsContentIntoTitleBar="True">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <ui:TitleBar x:Name="Bar" Title="Wormhole Send" ShowMaximize="False" ShowMinimize="False" />

        <!-- 1. Name -->
        <StackPanel x:Name="NamePage" Grid.Row="1" Margin="32,16,32,0">
            <ui:TextBlock FontTypography="Title" Text="{x:Static l:S.WelcomeTitle}" />
            <ui:TextBlock Margin="0,12,0,0" TextWrapping="Wrap"
                          Text="{x:Static l:S.WelcomeIntro}" />
            <ui:TextBlock Margin="0,28,0,6" FontTypography="BodyStrong" Text="{x:Static l:S.ThisComputersName}" />
            <ui:TextBox x:Name="AliasBox" MaxLength="64" />
            <ui:TextBlock Margin="0,6,0,0" Appearance="Secondary" FontTypography="Caption" Text="{x:Static l:S.NameHint}" />
        </StackPanel>

        <!-- 2. Network -->
        <StackPanel x:Name="NetworkPage" Grid.Row="1" Margin="32,16,32,0" Visibility="Collapsed">
            <ui:TextBlock FontTypography="Title" Text="{x:Static l:S.AllowNetwork}" />
            <ui:TextBlock Margin="0,12,0,0" TextWrapping="Wrap"
                          Text="{x:Static l:S.LocalOnly}" />
            <ui:TextBlock Margin="0,12,0,0" TextWrapping="Wrap"
                          Text="{x:Static l:S.FirewallHint}" />
            <ui:TextBlock x:Name="NetworkError" Margin="0,16,0,0" Foreground="#FFFF6B6B" TextWrapping="Wrap" Visibility="Collapsed" />
        </StackPanel>

        <!-- 3. First device -->
        <StackPanel x:Name="PairPage" Grid.Row="1" Margin="32,16,32,0" Visibility="Collapsed">
            <ui:TextBlock FontTypography="Title" Text="{x:Static l:S.FirstDevice}" />
            <ui:TextBlock Margin="0,12,0,0" TextWrapping="Wrap"
                          Text="{x:Static l:S.FirstDeviceIntro}" />
            <ui:Button Margin="0,20,0,0" Appearance="Primary" Content="{x:Static l:S.PairNew}" Click="Pair_Click">
                <ui:Button.Icon>
                    <ui:SymbolIcon Symbol="Add24" />
                </ui:Button.Icon>
            </ui:Button>
            <ui:TextBlock x:Name="PairedText" Margin="0,8,0,0" Appearance="Secondary" />
            <CheckBox x:Name="AutostartBox" Margin="0,24,0,0" Content="{x:Static l:S.StartAppWithWindows}" IsChecked="True" />
        </StackPanel>

        <StackPanel Grid.Row="2" Margin="32,0,32,24" HorizontalAlignment="Right" Orientation="Horizontal">
            <ui:Button x:Name="SkipButton" Content="{x:Static l:S.Skip}" Click="Finish_Click" Visibility="Collapsed" />
            <ui:Button x:Name="NextButton" Margin="8,0,0,0" Appearance="Primary" Content="{x:Static l:S.Next}" Click="Next_Click" />
        </StackPanel>
    </Grid>
</ui:FluentWindow>
